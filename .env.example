# Copie para .env (que NÃO vai para o Git) quando houver um backend.
# Só a URL e a chave "anon" do Supabase podem ir para o navegador (protegidas pelo RLS).
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=cole-a-chave-anon-aqui
# NUNCA coloque a chave service_role no site nem no GitHub:
# SUPABASE_SERVICE_ROLE_KEY=
